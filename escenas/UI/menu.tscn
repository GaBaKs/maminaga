[node name="Label" type="Label" parent="ContenidoDescription" unique_id=159158669]
layout_mode = 0
offset_left = 437.0
offset_top = 87.0
offset_right = 799.0
offset_bottom = 490.0
theme_override_colors/font_color = Color(0.30588236, 0.16470589, 0.1254902, 1)
theme_override_fonts/font = ExtResource("11_t3gcf")
theme_override_font_sizes/font_size = 18
text = "Maminaga es un juego de accion y aventura 
      con diversos mapas y dificultades. 
      Seleccioná un mapa y su dificultad 
  bajo tu propio riesgo: a mayor peligro, 
                  mayor recompensa! 
    Recorre las distintas islas y recolectá
 los valiosos minerales repartidos por ella, 
  pero tené cuidado con los monstruos 
     que no te dejarán irte facilmente. 
Cuando regreses podes invertir todo lo 
que recolectaste en mejores armas 
   para tu aventura y aumentar tus
           habilidades de combate.
           Que disfrutes del juego!"

